{
  "name": "144p-group",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-css.mjs",
    "test:runtime": "node --test --test-name-pattern=\"runtime:\" tests/browser.test.js",
    "test:seo": "node --test --test-name-pattern=\"SEO:\" tests/browser.test.js",
    "test:ux": "node --test --test-name-pattern=\"UX:\" tests/browser.test.js",
    "test:motion": "node --test --test-name-pattern=\"motion:\" tests/browser.test.js",
    "test:faq": "node --test --test-name-pattern=\"FAQ:\" tests/browser.test.js",
    "test:sizing": "node --test --test-name-pattern=\"sizing:\" tests/browser.test.js",
    "test:all": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "playwright": "1.56.1",
    "purgecss": "^8.0.0"
  }
}
